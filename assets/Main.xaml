<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="纯净网络检测工具" Width="1180" Height="780" MinWidth="940" MinHeight="720" WindowStartupLocation="CenterScreen"
 FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="{DynamicResource BodySize}" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}">
 <Window.Resources>
  <SolidColorBrush x:Key="Canvas" Color="#F3F5FA"/><SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Field" Color="#F8FAFC"/><SolidColorBrush x:Key="Ink" Color="#172033"/>
  <SolidColorBrush x:Key="Muted" Color="#64748B"/><SolidColorBrush x:Key="Line" Color="#DDE3EE"/>
  <SolidColorBrush x:Key="Accent" Color="#365FEA"/><SolidColorBrush x:Key="AccentSoft" Color="#EAF0FF"/>
  <SolidColorBrush x:Key="Hover" Color="#EDF1F8"/><SolidColorBrush x:Key="Good" Color="#168575"/>
  <SolidColorBrush x:Key="Danger" Color="#C24F58"/>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="BodySize">16</sys:Double>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="13,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.58"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="FavoriteStar" TargetType="ToggleButton">
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="FontSize" Value="22"/>
   <Setter Property="ToolTip" Value="{Binding FavoriteHint}"/><Setter Property="AutomationProperties.Name" Value="{Binding FavoriteHint}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="StarBox" CornerRadius="5" Background="Transparent"><TextBlock x:Name="Star" Text="☆" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Star" Property="Text" Value="★"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StarBox" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="StarBox" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="10,8"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentSoft}"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="19" Height="19" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Field}" VerticalAlignment="Center"><TextBlock x:Name="Tick" Text="✓" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/></Border><ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="10,12"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,11"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="0,0,0,0.5"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
 </Window.Resources>
 <Grid Margin="24,18,24,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="AppLogo" Width="44" Height="44" Margin="0,0,12,0"/><StackPanel><TextBlock Text="纯净网络" FontSize="25" FontWeight="Bold"/><TextBlock Text="选节点，生成检测报告。" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,3,0,0"/></StackPanel></StackPanel>
   <WrapPanel Grid.Column="1" VerticalAlignment="Center">
    <Button x:Name="ZoomOut" Content="A−" ToolTip="缩小文字  Ctrl + −" Padding="10,7"/>
    <Button x:Name="FontLabel" Content="12 pt" ToolTip="点击恢复默认字号  Ctrl + 0" Padding="10,7" Margin="5,0"/>
    <Button x:Name="ZoomIn" Content="A+" ToolTip="放大文字  Ctrl + =" Padding="10,7"/>
    <Button x:Name="Theme" Content="外观：跟随系统" FontSize="13" Margin="12,0,0,0"/>
    <Button x:Name="Settings" Content="设置" FontSize="13" Margin="6,0,0,0"/>
   </WrapPanel>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,15" Margin="0,0,0,16">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0"><TextBlock Text="当前查看的节点" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="CurrentNode" Text="尚未打开浏览器" Margin="0,6,0,0" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="16,0"><TextBlock Text="出口 IP" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="CurrentIP" Text="等待检测" FontSize="19" Margin="0,5,0,0" FontFamily="Consolas"/></StackPanel>
    <StackPanel Grid.Column="2" Margin="16,0,0,0"><TextBlock Text="地区与页面时区" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="CurrentZone" Text="检测后自动匹配" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="500"/><ColumnDefinition Width="16"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="16,16,16,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="节点" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="NodeCount" Text="正在读取…" FontSize="12" Foreground="{DynamicResource Muted}" Margin="10,5,0,0"/></StackPanel><Button x:Name="Reload" Grid.Column="1" Content="刷新节点" FontSize="13" Padding="10,6"/></Grid>
     <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <WrapPanel Margin="0,0,0,10"><Button x:Name="AllNodes" Content="全部节点" FontSize="13" Padding="10,6"/><Button x:Name="FavoriteNodes" Content="★ 我的收藏 (0)" FontSize="13" Padding="10,6" Margin="6,0,0,0"/><Button x:Name="QueryFavorites" Content="查询收藏" FontSize="13" Padding="10,6" Margin="6,0,0,0" ToolTip="查询当前搜索范围内所有收藏节点：CleanIP、风险项、人机比例及上传下载；测速每节点最多 20 MB"/></WrapPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Search" ToolTip="搜索节点名称或地区；在我的收藏中仅搜索收藏节点" AutomationProperties.Name="搜索节点"/><Button x:Name="SelectVisible" Content="全选" Grid.Column="1" FontSize="13" Margin="8,0,0,0"/><Button x:Name="ClearSelection" Content="清空" Grid.Column="2" FontSize="13" Margin="6,0,0,0"/></Grid>
     </StackPanel>
     <DataGrid x:Name="Nodes" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" FrozenColumnCount="2" HeadersVisibility="Column" GridLinesVisibility="None" Background="{DynamicResource Surface}" BorderThickness="0" RowHeaderWidth="0" EnableRowVirtualization="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <DataGrid.Columns>
       <DataGridTemplateColumn Width="40" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Chosen,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" ToolTip="加入批量任务"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="节点名称 / 收藏" SortMemberPath="Name" Width="*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel><ToggleButton DockPanel.Dock="Left" Style="{StaticResource FavoriteStar}" IsChecked="{Binding IsFavorite,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="CleanIP ↑" Binding="{Binding PurityDisplay}" SortMemberPath="CleanIpPurity" Width="100"/>
       <DataGridTextColumn Header="IP 风险 / 全过" Binding="{Binding CheckDisplay}" Width="160"/>
       <DataGridTextColumn Header="风险分 ↓" Binding="{Binding RiskDisplay}" SortMemberPath="CleanIpRisk" Width="95"/>
       <DataGridTextColumn Header="真人流量" Binding="{Binding HumanDisplay}" SortMemberPath="HumanPercent" Width="110"/>
       <DataGridTextColumn Header="机器流量" Binding="{Binding BotDisplay}" SortMemberPath="BotPercent" Width="110"/>
       <DataGridTextColumn Header="平均下载" Binding="{Binding DownloadDisplay}" SortMemberPath="DownloadMbps" Width="140"/>
       <DataGridTextColumn Header="平均上传" Binding="{Binding UploadDisplay}" SortMemberPath="UploadMbps" Width="140"/>
       <DataGridTextColumn Header="延迟" Binding="{Binding Delay}" SortMemberPath="DelayValue" Width="90"/>
       <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="125"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock x:Name="EmptyNodes" Grid.Row="2" Text="还没有收藏节点。切换到全部节点，点击名称旁的 ☆ 收藏。" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="18,42,18,18" Foreground="{DynamicResource Muted}" FontSize="13" IsHitTestVisible="False"/>
     <TextBlock x:Name="SelectionInfo" Grid.Row="3" Text="单击选一个 · 勾选可批量检测" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,12,0,12"/>
     <Border Grid.Row="4" Background="{DynamicResource Field}" CornerRadius="7" Padding="10,8" Margin="0,0,0,12"><ScrollViewer MaxHeight="40" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="NodeDetails" Text="选择节点查看出口、历史评分和风险原因。" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource Muted}"/></ScrollViewer></Border>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,16,16,12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,12">
      <TextBlock Text="CleanIP 快捷查询" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="QuickNode" Text="选择节点查看查询结果" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,6,0,10"/>
      <Button x:Name="QuickQuery" Content="查询所选节点" Style="{StaticResource Primary}" FontSize="15" ToolTip="查询评分、IP 风险项、人机比例，并实时测量本次平均上传和下载"/>
      <TextBlock Text="点击时测速 · 每节点上传下载共 ≤20 MB" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
     </StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <StackPanel x:Name="QuickMetrics">
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="纯净度 ↑" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding PurityDisplay,TargetNullValue=—,FallbackValue=—}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,6,0"/></StackPanel>
         <StackPanel Grid.Column="1"><TextBlock Text="风险分 ↓" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding RiskDisplay,TargetNullValue=—,FallbackValue=—}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
        </Grid>
        <Border Background="{DynamicResource Field}" CornerRadius="7" Padding="10" Margin="0,0,0,12"><StackPanel>
         <TextBlock Text="{Binding CheckDisplay,TargetNullValue=未查询,FallbackValue=未查询}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Accent}"/>
         <TextBlock Text="{Binding NetworkRiskDisplay}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
         <TextBlock Text="IP 风险项，不含浏览器环境检测" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel></Border>
        <TextBlock Text="人机流量 · 所属 ASN" FontSize="12" Foreground="{DynamicResource Muted}" ToolTip="来自 CleanIP 的 ASN 流量统计，不是个人浏览流量"/>
        <Grid Margin="0,5,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="真人" FontSize="11"/><TextBlock Text="{Binding HumanDisplay,TargetNullValue=未获取,FallbackValue=未获取}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
         <StackPanel Grid.Column="1"><TextBlock Text="机器" FontSize="11"/><TextBlock Text="{Binding BotDisplay,TargetNullValue=未获取,FallbackValue=未获取}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
        </Grid>
        <TextBlock Text="本次平均速度 · Cloudflare 测速" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="平均下载" FontSize="11"/><TextBlock Text="{Binding DownloadDisplay,TargetNullValue=未测速,FallbackValue=未测速}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,4,0"/></StackPanel>
         <StackPanel Grid.Column="1"><TextBlock Text="平均上传" FontSize="11"/><TextBlock Text="{Binding UploadDisplay,TargetNullValue=未测速,FallbackValue=未测速}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
        </Grid>
        <TextBlock Text="{Binding QualityTimeDisplay}" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <TextBlock Text="{Binding RiskDetails}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,12"/>
       </StackPanel>
       <Button x:Name="Open" Content="手动打开节点窗口" FontSize="13" Margin="0,4,0,10" ToolTip="需要网站验证时，可手动打开正常页面；成功结果会同步回来"/>
       <Expander Header="其他网站与报告" FontSize="12" Foreground="{DynamicResource Ink}"><StackPanel Margin="0,10,0,0">
        <Button x:Name="EditSites" Content="编辑检测站点" FontSize="12" Margin="0,0,0,8"/>
        <ItemsControl x:Name="Sites"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,5"><TextBlock Text="{Binding Host}" FontSize="12" TextWrapping="Wrap" ToolTip="{Binding Url}"/></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <CheckBox x:Name="ReportDownload" IsChecked="True" Margin="0,12,0,10"><TextBlock Text="报告含下载测速（≤10 MB/节点）" TextWrapping="Wrap" FontSize="11"/></CheckBox>
        <Button x:Name="Check" Content="生成检测报告" FontSize="13"/>
        <TextBlock x:Name="WindowCount" Text="测试窗口 0 / 4 · 环境长期复用" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
       </StackPanel></Expander>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,16,0,0">
   <WrapPanel Margin="0,0,0,12"><Button x:Name="CleanIp" Content="测 IP 质量" FontSize="14"/><Button x:Name="Delay" Content="所选测延迟" FontSize="14" Margin="8,0,0,0"/><Button x:Name="DelayAll" Content="全部测延迟" FontSize="14" Margin="8,0,0,0"/><Button x:Name="Speed" Content="所选测下载" FontSize="14" Margin="8,0,0,0"/><Button x:Name="CloseBrowsers" Content="关闭所选窗口" FontSize="14" Margin="8,0,0,0"/><Button x:Name="Export" Content="导出" FontSize="14" Margin="8,0,0,0"/><Button x:Name="Reports" Content="查看报告" FontSize="14" Margin="8,0,0,0"/><Button x:Name="Cancel" Content="停止" FontSize="14" Foreground="{DynamicResource Danger}" Margin="8,0,0,0" IsEnabled="False"/></WrapPanel>
   <ProgressBar x:Name="Progress" Height="3" BorderThickness="0" Background="{DynamicResource Line}" Foreground="{DynamicResource Accent}" Maximum="100"/>
   <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="正在准备…" FontSize="13" TextWrapping="Wrap"/><TextBlock x:Name="Source" Grid.Column="1" Text="2.0" FontSize="11" Foreground="{DynamicResource Muted}" Margin="12,2,0,0"/></Grid>
  </StackPanel>
 </Grid>
</Window>
