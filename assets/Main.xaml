<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="纯净网络检测工具" Width="1180" Height="780" MinWidth="940" MinHeight="640" WindowStartupLocation="CenterScreen"
 FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="{DynamicResource BodySize}" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}">
 <Window.Resources>
  <SolidColorBrush x:Key="Canvas" Color="#F3F5FA"/><SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Field" Color="#F8FAFC"/><SolidColorBrush x:Key="Ink" Color="#172033"/>
  <SolidColorBrush x:Key="Muted" Color="#64748B"/><SolidColorBrush x:Key="Line" Color="#DDE3EE"/>
  <SolidColorBrush x:Key="Accent" Color="#365FEA"/><SolidColorBrush x:Key="AccentSoft" Color="#EAF0FF"/>
  <SolidColorBrush x:Key="Hover" Color="#EDF1F8"/><SolidColorBrush x:Key="Good" Color="#168575"/>
  <SolidColorBrush x:Key="Danger" Color="#C24F58"/>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="BodySize">16</sys:Double>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="13,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.58"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="10,8"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentSoft}"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="19" Height="19" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Field}" VerticalAlignment="Center"><TextBlock x:Name="Tick" Text="✓" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/></Border><ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="10,12"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,11"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="0,0,0,0.5"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
 </Window.Resources>
 <Grid Margin="24,18,24,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="AppLogo" Width="44" Height="44" Margin="0,0,12,0"/><StackPanel><TextBlock Text="纯净网络" FontSize="25" FontWeight="Bold"/><TextBlock Text="选节点，生成检测报告。" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,3,0,0"/></StackPanel></StackPanel>
   <WrapPanel Grid.Column="1" VerticalAlignment="Center">
    <Button x:Name="ZoomOut" Content="A−" ToolTip="缩小文字  Ctrl + −" Padding="10,7"/>
    <Button x:Name="FontLabel" Content="12 pt" ToolTip="点击恢复默认字号  Ctrl + 0" Padding="10,7" Margin="5,0"/>
    <Button x:Name="ZoomIn" Content="A+" ToolTip="放大文字  Ctrl + =" Padding="10,7"/>
    <Button x:Name="Theme" Content="外观：跟随系统" FontSize="13" Margin="12,0,0,0"/>
    <Button x:Name="Settings" Content="设置" FontSize="13" Margin="6,0,0,0"/>
   </WrapPanel>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,15" Margin="0,0,0,16">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0"><TextBlock Text="最近检测的节点" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="CurrentNode" Text="尚未打开浏览器" Margin="0,6,0,0" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="16,0"><TextBlock Text="出口 IP" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="CurrentIP" Text="等待检测" FontSize="19" Margin="0,5,0,0" FontFamily="Consolas"/></StackPanel>
    <StackPanel Grid.Column="2" Margin="16,0,0,0"><TextBlock Text="地区与页面时区" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="CurrentZone" Text="检测后自动匹配" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="500"/><ColumnDefinition Width="16"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="16,16,16,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="节点" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="NodeCount" Text="正在读取…" FontSize="12" Foreground="{DynamicResource Muted}" Margin="10,5,0,0"/></StackPanel><Button x:Name="Reload" Grid.Column="1" Content="刷新节点" FontSize="13" Padding="10,6"/></Grid>
     <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Search" ToolTip="搜索节点名称或地区"/><Button x:Name="SelectVisible" Content="全选" Grid.Column="1" FontSize="13" Margin="8,0,0,0"/><Button x:Name="ClearSelection" Content="清空" Grid.Column="2" FontSize="13" Margin="6,0,0,0"/></Grid>
     <DataGrid x:Name="Nodes" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" Background="{DynamicResource Surface}" BorderThickness="0" RowHeaderWidth="0" EnableRowVirtualization="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <DataGrid.Columns>
       <DataGridTemplateColumn Width="40" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Chosen,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" ToolTip="加入批量任务"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="节点名称" Binding="{Binding Name}" Width="*" MinWidth="180"/>
       <DataGridTextColumn Header="延迟" Binding="{Binding Delay}" SortMemberPath="DelayValue" Width="88"/>
       <DataGridTextColumn Header="下载 Mbps" Binding="{Binding Speed}" SortMemberPath="SpeedValue" Width="104"/>
       <DataGridTextColumn Header="CleanIP ↑" Binding="{Binding PurityDisplay}" SortMemberPath="CleanIpPurity" Width="92"/>
       <DataGridTextColumn Header="风险 ↓" Binding="{Binding RiskDisplay}" SortMemberPath="CleanIpRisk" Width="76"/>
       <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="110"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock x:Name="SelectionInfo" Grid.Row="3" Text="单击选一个 · 勾选可批量检测" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,12,0,12"/>
     <Border Grid.Row="4" Background="{DynamicResource Field}" CornerRadius="7" Padding="10,8" Margin="0,0,0,12"><ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="NodeDetails" Text="选择节点查看出口、历史评分和风险原因。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}"/></ScrollViewer></Border>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,18,18,14">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="检测站点" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="EditSites" Grid.Column="1" Content="编辑" Padding="10,5" FontSize="13"/></Grid>
     <TextBlock Grid.Row="1" Text="勾选网站，地址可自定义。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,9,0,12"/>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="Sites"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Field}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8"><CheckBox IsChecked="{Binding Enabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"><TextBlock Text="{Binding Host}" TextWrapping="Wrap" FontSize="{DynamicResource BodySize}" ToolTip="{Binding Url}"/></CheckBox></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     <StackPanel Grid.Row="3" Margin="0,12,0,0"><CheckBox x:Name="ReportDownload" IsChecked="True" Margin="0,0,0,10"><TextBlock Text="报告包含下载测速（≤10 MB/节点）" TextWrapping="Wrap" FontSize="11"/></CheckBox><Button x:Name="Check" Content="生成检测报告" Style="{StaticResource Primary}" ToolTip="后台汇总延迟、下载速度、出口与网站结果，不弹出测试窗口"/><Button x:Name="Open" Content="手动打开节点窗口" Margin="0,8,0,0" FontSize="13" ToolTip="最多四个独立窗口，标题和页面标明节点"/><TextBlock Text="报告自动检测；窗口用于手动复核。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/></StackPanel>
     <TextBlock x:Name="WindowCount" Grid.Row="4" Text="测试窗口 0 / 4 · 环境长期复用" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,18,0,0"/>
    </Grid>
   </Border>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,16,0,0">
   <WrapPanel Margin="0,0,0,12"><Button x:Name="CleanIp" Content="测 IP 质量" FontSize="14"/><Button x:Name="Delay" Content="所选测延迟" FontSize="14" Margin="8,0,0,0"/><Button x:Name="DelayAll" Content="全部测延迟" FontSize="14" Margin="8,0,0,0"/><Button x:Name="Speed" Content="所选测下载" FontSize="14" Margin="8,0,0,0"/><Button x:Name="CloseBrowsers" Content="关闭所选窗口" FontSize="14" Margin="8,0,0,0"/><Button x:Name="Export" Content="导出" FontSize="14" Margin="8,0,0,0"/><Button x:Name="Reports" Content="查看报告" FontSize="14" Margin="8,0,0,0"/><Button x:Name="Cancel" Content="停止" FontSize="14" Foreground="{DynamicResource Danger}" Margin="8,0,0,0" IsEnabled="False"/></WrapPanel>
   <ProgressBar x:Name="Progress" Height="3" BorderThickness="0" Background="{DynamicResource Line}" Foreground="{DynamicResource Accent}" Maximum="100"/>
   <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="正在准备…" FontSize="13" TextWrapping="Wrap"/><TextBlock x:Name="Source" Grid.Column="1" Text="2.0" FontSize="11" Foreground="{DynamicResource Muted}" Margin="12,2,0,0"/></Grid>
  </StackPanel>
 </Grid>
</Window>
